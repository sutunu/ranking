{
  "name": "tier-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pages:dev": "wrangler pages dev dist",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.cjs",
    "start:local": "node scripts/local-server.mjs",
    "test:live": "node tests/browser-live.cjs",
    "format": "prettier --write src server functions scripts tests README.md index.html vite.config.ts tsconfig.json package.json",
    "test:genres": "node tests/browser-genres.cjs",
    "test:anime": "node tests/anime-matrix.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "undici": "^8.12.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
